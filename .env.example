# Copy this file to .env and use a strong, random password for local development.
POSTGRES_PASSWORD=replace-with-a-random-password

# Generate with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET_BASE64=replace-with-base64-encoded-random-32-byte-secret
JWT_ISSUER_URI=http://user-service:8080
JWT_AUDIENCE=quickbite-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Payment provider simulation only. No real payment processor is contacted.
PAYMENT_MOCK_ENABLED=true

# Optional: create or promote this account to ADMIN on service startup.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Token bucket limits are per authenticated user, or per client IP before login.
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_REPLENISH_RATE=20
GATEWAY_RATE_LIMIT_BURST_CAPACITY=40
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
